NODE_ENV=development
PORT=4451
MONGODB_URI=mongodb://localhost:27017/hms
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Optional SMTP for password-reset and document email delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Production secret manager / storage
SECRETS_PROVIDER=env
AWS_REGION=us-east-1
AWS_SECRET_NAME=hms/app-secrets
AWS_SES_FROM_EMAIL=
AWS_S3_BUCKET=
LOG_LEVEL=info

# Vercel production requires a TLS MongoDB deployment and rediss:// Redis.
# Use separate database credentials for preview deployments.
CRON_SECRET=
DEMO_MODE=false
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
ALLOW_PREVIEW_DATABASE=false

# One-time bootstrap values used only by `npm run create-admin`.
# Remove FIRST_ADMIN_PASSWORD from .env immediately after bootstrap succeeds.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
FIRST_ADMIN_FIRST_NAME=Platform
FIRST_ADMIN_LAST_NAME=Administrator
FIRST_HOSPITAL_NAME=My Hospital
FIRST_HOSPITAL_SYSTEM_NAME=My Hospital Management System
FIRST_HOSPITAL_SHORT_NAME=HMS
FIRST_HOSPITAL_SLUG=my-hospital

# Local emergency recovery command: npm run recover-admin
# Remove these values immediately after a successful recovery.
ADMIN_RECOVERY_EMAIL=admin@example.com
ADMIN_RECOVERY_PASSWORD=replace-with-a-new-strong-password
